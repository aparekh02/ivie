{
  "name": "zknet",
  "version": "1.0.0",
  "description": "Mainnet-fidelity anvil testnet + a StarkWare-style STARK rollup verified on L1",
  "scripts": {
    "chain:start": "node chain/zknet.mjs start",
    "chain:start:fast": "node chain/zknet.mjs start --fast",
    "chain:stop": "node chain/zknet.mjs stop",
    "chain:status": "node chain/zknet.mjs status",
    "chain:snapshot": "node chain/snapshot.mjs",
    "fidelity": "node chain/fidelity.mjs",
    "test:contracts": "cd contracts && forge test",
    "test": "npm run test:contracts && npm run test:client && npm run fidelity",
    "zknetd": "cargo run --release --manifest-path client/Cargo.toml -p zknetd --",
    "test:client": "cargo test --release --manifest-path client/Cargo.toml",
    "rollup": "cargo run --release --manifest-path client/Cargo.toml -p rollup --"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "viem": "^2.57.20"
  },
  "private": true
}
